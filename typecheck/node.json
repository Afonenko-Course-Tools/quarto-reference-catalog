{
  "compilerOptions": {
    "strict": true,
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2023",
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitReturns": true
  },
  "files": ["browser.d.ts"],
  "include": ["../**/*.cjs", "../**/*.mjs"],
  "exclude": ["../node_modules", "../tests/dependencies", "../_extensions/reference-catalog/vendor"]
}
